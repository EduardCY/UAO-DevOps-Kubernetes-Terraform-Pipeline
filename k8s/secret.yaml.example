# Example Secret for sensitive data
# IMPORTANT: DO NOT commit the actual secret.yaml file
# This is a template - copy to secret.yaml and fill with base64-encoded values

# To encode values in base64:
# echo -n 'your-value' | base64

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  labels:
    app: crud-app
type: Opaque
data:
  # PostgreSQL connection string (base64 encoded)
  # Example: postgresql://postgres:password@host:5432/railway
  database-url: cG9zdGdyZXNxbDovL3Bvc3RncmVzOnBhc3N3b3JkQGhvc3Q6NTQzMi9yYWlsd2F5Cg==
  
  # Additional secrets can be added here
  # jwt-secret: <base64-encoded-jwt-secret>
  # api-key: <base64-encoded-api-key>
