# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to version control

# Render API Key (get from https://dashboard.render.com/account/api-keys)
render_api_key = "rnd_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# PostgreSQL connection string from Railway
database_url = "postgresql://postgres:PASSWORD@host:port/railway"

# GitHub repository URL (optional, defaults to current repo)
# repo_url = "https://github.com/YourUsername/YourRepo"

# Deployment environment (optional, defaults to production)
# environment = "production"
